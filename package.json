{
  "name": "hali-desktop",
  "version": "0.1.0",
  "description": "A little room for your desktop mess",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "preview": "node scripts/preview.cjs",
    "test": "node --test test/*.test.cjs",
    "test:app": "electron scripts/smoke.cjs",
    "test:native": "electron scripts/native-smoke.cjs",
    "native": "node scripts/build-native.cjs",
    "dist:mac": "npm run native && electron-builder --mac --universal",
    "dist:win": "npm run native && electron-builder --win",
    "dist:win:installer": "npm run native && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.hali.desktop",
    "productName": "Halı",
    "npmRebuild": false,
    "files": [
      "desktop/**",
      "ui/**",
      "native/build/*.node",
      "package.json"
    ],
    "asarUnpack": [
      "native/build/*.node"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "native/entitlements.mac.plist",
      "entitlementsInherit": "native/entitlements.mac.plist",
      "artifactName": "Hali-${version}-macOS-universal.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "extraResources": [
        {
          "from": "native/build",
          "to": "helpers",
          "filter": [
            "DesktopLayer.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Hali-${version}-Portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
